{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {% if site.title and site.title != 'blank' %}{{ site.title }}{% else %}{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}{% endif %}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Note legali</a>.
  {% endif %}
  {% if site.last_updated %}
    Ultimo aggiornamento: {{ 'now' | data_it: '%d %B %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center.liquid %}
      {% else %}
        {% include newsletter.liquid %}
      {% endif %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}

<!-- Bottoni flottanti: torna-su (in alto) , sempre sopra il footer fisso -->
<style>
  :root { --footer-h: 40px; }
  #back-to-top {
    z-index: 1031 !important;
    right: 30px !important;
    bottom: calc(var(--footer-h) + 62px) !important;
  }
  #back-to-top.hidden {
    bottom: -100px !important;
  }
</style>
<script>
  // Misura l'altezza reale del footer (cambia su mobile quando il testo va a capo)
  (function () {
    function setFooterH() {
      var f = document.querySelector('footer.fixed-bottom');
      var h = f ? f.offsetHeight : 0;
      document.documentElement.style.setProperty('--footer-h', h + 'px');
    }
    window.addEventListener('load', setFooterH);
    window.addEventListener('resize', setFooterH);
    setFooterH();
  })();
</script>

{% comment %}
  INDICE ARTICOLO (2026-09-21): stile della cornice "Indice" per il TOC automatico dei post.
  Perche' qui: il layout post della gem stampa <div id="table-of-contents"> ma non ha CSS suo, e
  il repo non puo' avere _sass/ (style contract, vedi AGENTS.md). Il footer e' incluso in ogni
  pagina, quindi lo stile arriva a tutti i post senza toccare la gem. Solo selettori
  #table-of-contents: non tocca nient'altro. Colori dark via html[data-theme="dark"] (theme.js).
  SOGLIA 2+ VOCI (2026-09-21): jekyll-toc genera sempre il box, anche con 1 solo titolo o 0
  (box vuoto) — non ha un'opzione "minimo N heading". Lo script sotto nasconde il box quando
  ha meno di 2 <li> nel <ul id="toc">, cosi' compare solo se ha senso mostrarlo.
  STILE NEUTRO (2026-09-22): tolto il tema "pergamena" (bordo/sfondo giallo-oro, texture rumore)
  perche' non coerente col resto del sito. Ora bordo grigio chiaro sottile e sfondo bianco, in
  linea con le altre card del sito (vedi .srv-home-card in _pages/home.md: stesso bordo
  rgba(0,0,0,.12) e stesso sfondo). Applicato prima su crazyweb4test (commit 959d57e), replicato
  qui su crazyweb4 il 22/09/2026 su richiesta in chat ("stesso sito, replicalo"). Non rimettere
  i colori gialli senza che venga richiesto di nuovo.
{% endcomment %}
<style>
#table-of-contents{position:relative;display:inline-block;width:fit-content;max-width:100%;min-width:180px;margin:1.6rem 0 2.2rem;padding:1.3rem 1.4rem 1rem;border:1px solid rgba(0,0,0,.12);border-radius:12px;background-color:#fff;box-shadow:0 1px 2px rgba(0,0,0,.04)}
#table-of-contents::before{content:"Indice";position:absolute;top:0;left:1.2rem;transform:translateY(-50%);padding:.1rem .8rem;border:1px solid rgba(0,0,0,.12);border-radius:999px;background:#fff;font-size:.85rem;font-weight:700;letter-spacing:.04em;line-height:1.4;color:inherit}
#table-of-contents ul{list-style:none;margin:0;padding:0}
#table-of-contents li{margin:0}
#table-of-contents a{display:block;padding:.2rem 0;line-height:1.35}
#table-of-contents .toc-h2>a{font-weight:600}
#table-of-contents ul ul{margin:.05rem 0 .3rem .9rem;padding-left:.7rem}
#table-of-contents .toc-h3>a,#table-of-contents .toc-h4>a{font-weight:400}
#table-of-contents+hr{display:none}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
html[data-theme="dark"] #table-of-contents{border-color:rgba(255,255,255,.15);background-color:rgba(255,255,255,.05);box-shadow:none}
html[data-theme="dark"] #table-of-contents::before{border-color:rgba(255,255,255,.15);background:var(--global-bg-color);color:inherit}
@media (max-width:576px){#table-of-contents{padding:1.2rem 1rem .9rem;border-radius:12px}}
/* toc_style: side (da _config.yml). Regole adattate da al-folio-distill.css (d-article d-contents): colonna a sinistra, sticky, filo verticale. Sotto 1024px torna il box. */
@media (min-width:1025px){
html[data-toc-style="side"] #table-of-contents{position:fixed;top:5.5rem;left:max(1rem,calc((100vw - 1140px)/2 - 15rem));display:block;width:14rem;max-height:calc(100vh - 7rem);overflow:auto;min-width:0;margin:0;padding:0 1.2rem 0 0;border:0;border-right:1px solid var(--global-divider-color);border-radius:0;background:none;box-shadow:none}
html[data-toc-style="side"] #table-of-contents::before{content:"Indice";position:static;transform:none;display:block;padding:0;margin:0 0 .8em;border:0;border-radius:0;background:none;font-size:1rem;font-weight:700;letter-spacing:0;color:var(--global-text-color)}
html[data-toc-style="side"] #table-of-contents a{border-bottom:none;font-size:.9rem}
html[data-toc-style="side"] #table-of-contents a:hover{border-bottom:1px solid var(--global-text-color)}
}
</style>
<script>
  (function () {
    var box = document.getElementById('table-of-contents');
    if (!box) return;
    document.documentElement.setAttribute('data-toc-style', '{{ site.toc_style | default: "box" }}');
    var items = box.querySelectorAll('#toc > li');
    if (items.length < 2) {
      box.style.display = 'none';
      var hr = box.nextElementSibling;
      if (hr && hr.tagName === 'HR') hr.style.display = 'none';
    }
  })();
</script>
{% comment %}
  MODULI: aggancio 'footer' (HTML/JS dei moduli attivi, fine pagina). Vedi modules_hook.liquid.
  FIX 2026-09-20: questo include era duplicato (anche subito dopo il footer standard, prima dei
  bottoni flottanti): ogni modulo con hook footer veniva stampato DUE VOLTE nel DOM. Tenuta solo
  questa occorrenza, in fondo, dopo lo script che misura --footer-h: se un modulo aggiunge il
  proprio JS che legge quella variabile CSS o l'altezza del footer, la trova gia' pronta.
  Se togli questa riga i moduli con hook footer spariscono dal sito.
{% endcomment %}
{% include modules_hook.liquid hook='footer' %}
